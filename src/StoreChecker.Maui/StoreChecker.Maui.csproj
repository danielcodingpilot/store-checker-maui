<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StoreChecker.Maui</RootNamespace>
    <AssemblyName>StoreChecker.Maui</AssemblyName>

    <PackageId>StoreChecker.Maui</PackageId>
    <Version>1.0.0</Version>
    <Authors>danielcodingpilot</Authors>
    <Description>Detect whether a .NET MAUI app was installed from the Play Store, App Store, TestFlight, or a local source.</Description>
    <PackageTags>maui;android;ios;play-store;app-store;testflight;store-checker</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/danielcodingpilot/store-checker-maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Platforms\**\*.cs" Pack="false" />
  </ItemGroup>
</Project>
